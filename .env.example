# ============================================
# RINOSTEAM — Variables de entorno requeridas
# Copia este archivo como .env.local y rellena los valores
# ============================================

# Supabase — https://app.supabase.com > tu proyecto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_PRIVADA

# WhatsApp — número SIN + ni espacios, con código de país
# Venezuela +58 4262031630 → 584262031630
# Chile     +56 9XXXXXXXX  → 569XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=584262301632

# URL del sitio en producción (para OG images y metadataBase)
NEXT_PUBLIC_SITE_URL=https://rinosteam.com

# Admin (referencia — el usuario se crea en Supabase Auth > Add User)
ADMIN_EMAIL=admin@rinosteam.com
